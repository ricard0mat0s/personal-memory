AUTH0_ISSUER=https://YOUR_TENANT.us.auth0.com/
# Must equal MCP_RESOURCE_URL: Auth0's API Identifier is the public MCP URL.
AUTH0_AUDIENCE=https://memory.example.com/mcp
MCP_RESOURCE_URL=https://memory.example.com/mcp
MCP_HOST=127.0.0.1
# Comma-separated exact JWT sub values. Your Auth0 user is normally auth0|USER_ID.
# For the optional Postman M2M smoke test use CLIENT_ID@clients instead.
AUTH0_ALLOWED_SUBJECTS=auth0|YOUR_USER_ID
